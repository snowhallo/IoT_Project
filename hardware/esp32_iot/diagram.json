{
  "version": 1,
  "author": "Nguyen Tuan Tai",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -120,
      "left": -100,
      "attrs": { "temperature": "28.5", "humidity": "68" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": -120,
      "left": 120,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 150,
      "left": -80,
      "attrs": { "color": "red", "label": "LED 1 (GPIO2)" }
    },
    {
      "type": "wokwi-led",
      "id": "led2",
      "top": 150,
      "left": 80,
      "attrs": { "color": "green", "label": "LED 2 (GPIO4)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 100,
      "left": -80,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 100,
      "left": 80,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "dht1:SDA", "esp:15", "green", [ "v0" ] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "ldr1:AO", "esp:34", "yellow", [ "v0" ] ],
    [ "esp:2", "r1:1", "orange", [ "v0" ] ],
    [ "r1:2", "led1:A", "orange", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:4", "r2:1", "blue", [ "v0" ] ],
    [ "r2:2", "led2:A", "blue", [ "v0" ] ],
    [ "led2:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
